VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the project's publishable/anon key here, never the backend service-role key.
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# true = log in with any email + 4+ char password, no backend needed
VITE_USE_MOCK=false
